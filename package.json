{
  "name": "mahdiahmadirad.github.io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "astro check",
    "build": "astro build",
    "test": "tsx --test tests/unit/*.test.*",
    "test:e2e": "astro build && playwright test tests/e2e",
    "test:visual": "astro build && playwright test tests/visual",
    "evidence:design-system": "astro build && node scripts/capture-design-system.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "7.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
