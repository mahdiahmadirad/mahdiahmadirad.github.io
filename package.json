{
  "name": "mahdiahmadirad.github.io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "validate:build": "node scripts/validate-build.mjs",
    "test": "tsx --test tests/unit/*.test.*",
    "test:e2e": "npm run build && playwright test tests/e2e tests/accessibility",
    "test:a11y": "npm run build && playwright test tests/accessibility",
    "test:visual": "npm run build && playwright test --config playwright.visual.config.js",
    "quality": "npm run format:check && npm run lint && npm run check && npm run test && npm run build && npm run validate:build && playwright test tests/e2e tests/accessibility && playwright test --config playwright.visual.config.js",
    "evidence:publishing": "npm run build && node scripts/capture-publishing.mjs",
    "evidence:design-system": "astro build && node scripts/capture-design-system.mjs",
    "evidence:home": "astro build && node scripts/capture-home.mjs",
    "evidence:brand-candidate": "astro build && node scripts/capture-brand-candidate.mjs",
    "evidence:article": "astro build && node scripts/capture-article.mjs",
    "evidence:article-review": "astro build && node scripts/capture-article-review.mjs",
    "evidence:secondary": "astro build && node scripts/capture-secondary.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "html-validate": "11.6.0",
    "pagefind": "1.5.2",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
