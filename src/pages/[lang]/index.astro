---
import BottomIndex from '../../components/home/BottomIndex.astro';
import FeaturedEssay from '../../components/home/FeaturedEssay.astro';
import WritingList from '../../components/home/WritingList.astro';
import SystemGraphic from '../../components/global/SystemGraphic.astro';
import { getAlternateLocale, locales, type Locale } from '../../i18n/locales';
import { localeHomePath } from '../../i18n/routing';
import { getUi } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHomePageData } from '../../lib/home';

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
const ui = getUi(locale);
const alternatePath = localeHomePath(getAlternateLocale(locale));
const home = await getHomePageData(locale);
---

<BaseLayout
  locale={locale}
  title={ui.home.pageTitle}
  description={ui.home.subtitle}
  alternatePath={alternatePath}
  currentPath={localeHomePath(locale)}
  footerFlush
  noindex
  pageType={ui.secondary.search.resultTypes.page}
>
  <article class="home" data-home-page>
    <header class="home-hero page-shell">
      <div class="home-hero__copy">
        <span class="home-hero__rule" aria-hidden="true"></span>
        <h1>{ui.siteName}</h1>
        <p>{ui.home.subtitle}</p>
        <a href={`/${locale}/about/`}>{ui.home.aboutLink}</a>
      </div>
      <div class="home-hero__graphic">
        <SystemGraphic />
      </div>
    </header>

    <p class="fixture-banner page-shell">
      <span>{ui.home.sampleLabel}</span>
      {ui.home.fixtureNotice}
    </p>

    <FeaturedEssay locale={locale} article={home.featured} />
    <WritingList locale={locale} articles={home.recent} />
    <BottomIndex
      locale={locale}
      topics={home.topics}
      projects={home.projects}
    />
  </article>
</BaseLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    gap: var(--space-6);
    min-block-size: min(43rem, calc(100vh - var(--header-height)));
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .home-hero__copy {
    grid-column: 1 / span 6;
    position: relative;
    z-index: 1;
  }

  .home-hero__rule {
    display: block;
    inline-size: var(--space-10);
    border-block-start: var(--border-accent) solid var(--color-accent);
    margin-block-end: var(--space-6);
  }

  .home-hero h1 {
    max-inline-size: 40rem;
  }

  .home-hero__copy > p {
    max-inline-size: 33rem;
    margin-block-start: var(--space-6);
    color: var(--color-lapis);
    font-family: var(--font-reading);
    font-size: var(--step-2);
    line-height: var(--reading-leading);
  }

  .home-hero__copy > a {
    display: inline-flex;
    min-block-size: var(--tap-min);
    align-items: center;
    margin-block-start: var(--space-8);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .home-hero__graphic {
    grid-column: 7 / -1;
    min-inline-size: 0;
    opacity: 0.94;
  }

  .fixture-banner {
    display: flex;
    gap: var(--space-3);
    border-block-start: var(--border-thin) solid var(--color-rule);
    padding-block: var(--space-4);
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }

  .fixture-banner span {
    flex: none;
    color: var(--color-accent);
    font-weight: 700;
  }

  @media (max-width: 48rem) {
    .home-hero {
      grid-template-columns: 1fr;
      min-block-size: auto;
    }

    .home-hero__copy,
    .home-hero__graphic {
      grid-column: 1;
    }

    .home-hero__graphic {
      max-inline-size: 34rem;
      margin-block-start: var(--space-8);
    }
  }

  @media (max-width: 25rem) {
    .fixture-banner {
      flex-direction: column;
    }
  }
</style>
