---
import LocaleFoundation from '../../layouts/LocaleFoundation.astro';
import { getPublishedArticles } from '../../lib/content/repository';
import { locales, type Locale } from '../../i18n/locales';

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;

await getPublishedArticles(locale);
---

<LocaleFoundation locale={locale} />
