---
import PageIntro from '../../../../components/secondary/PageIntro.astro';
import WritingList from '../../../../components/home/WritingList.astro';
import { getAlternateLocale, type Locale } from '../../../../i18n/locales';
import { localeHomePath, topicPath } from '../../../../i18n/routing';
import { getUi } from '../../../../i18n/ui';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
  getTopicPage,
  getTopicPaths,
  getTopicTranslation,
  type TopicEntry,
} from '../../../../lib/secondary';

interface Props {
  entry: TopicEntry;
}

export async function getStaticPaths() {
  return getTopicPaths();
}

const { entry } = Astro.props;
const locale = entry.data.lang as Locale;
const ui = getUi(locale);
const alternateLocale = getAlternateLocale(locale);
const currentPath = topicPath(locale, entry.data.slug);
const translation = await getTopicTranslation(entry, alternateLocale);
const alternatePath =
  translation.state === 'available'
    ? topicPath(alternateLocale, translation.entry.data.slug)
    : localeHomePath(alternateLocale);
const alternates = {
  [locale]: currentPath,
  ...(translation.state === 'available'
    ? { [alternateLocale]: alternatePath }
    : {}),
};
const articles = await getTopicPage(entry);
---

<BaseLayout
  locale={locale}
  title={`${entry.data.name} — ${ui.siteName}`}
  description={entry.data.description}
  alternatePath={alternatePath}
  currentPath={`/${locale}/topics/`}
  canonicalPath={currentPath}
  alternates={alternates}
  noindex={entry.data.sample}
  pageType={ui.secondary.search.resultTypes.topic}
  pageTopic={entry.data.name}
>
  <article
    class="secondary-page"
    data-topic-detail
    data-topic-key={entry.data.translationKey}
  >
    <PageIntro
      eyebrow={entry.data.sample ? ui.secondary.sampleLabel : undefined}
      title={entry.data.name}
      intro={entry.data.description}
      notice={entry.data.sample ? ui.secondary.fixtureNotice : undefined}
    />
    <WritingList
      locale={locale}
      articles={articles}
      title={entry.data.sample
        ? ui.secondary.topics.writingTitle
        : ui.secondary.topics.publishedWritingTitle}
      sectionId="topic-writing-title"
    />
  </article>
</BaseLayout>
