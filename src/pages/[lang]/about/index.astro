---
import { render } from 'astro:content';

import PageIntro from '../../../components/secondary/PageIntro.astro';
import {
  getAlternateLocale,
  locales,
  type Locale,
} from '../../../i18n/locales';
import { aboutPath } from '../../../i18n/routing';
import { getUi } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAboutPage, getBrandStoryLink } from '../../../lib/secondary';

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
const ui = getUi(locale);
const alternateLocale = getAlternateLocale(locale);
const currentPath = aboutPath(locale);
const alternatePath = aboutPath(alternateLocale);
const entry = await getAboutPage(locale);
const brandStory = await getBrandStoryLink(locale);
const { Content } = await render(entry);
---

<BaseLayout
  locale={locale}
  title={ui.secondary.about.pageTitle}
  description={entry.data.description}
  alternatePath={alternatePath}
  currentPath={currentPath}
  canonicalPath={currentPath}
  alternates={{ [locale]: currentPath, [alternateLocale]: alternatePath }}
  noindex
  pageType={ui.secondary.search.resultTypes.about}
>
  <article class="secondary-page" data-about-page>
    <PageIntro
      eyebrow={ui.secondary.sampleLabel}
      title={ui.secondary.about.title}
      intro={ui.secondary.about.intro}
      notice={ui.secondary.about.notice}
    />
    <div
      class:list={[
        'placeholder-prose prose reading-column page-shell',
        { 'placeholder-prose--followed': brandStory },
      ]}
    >
      <Content />
    </div>
    {
      brandStory && (
        <section
          class="about-brand-story page-shell"
          aria-labelledby="about-brand-story-title"
          data-brand-story-link
        >
          <div>
            <p class="eyebrow">{ui.secondary.brandStory.eyebrow}</p>
            <h2 id="about-brand-story-title">
              {ui.secondary.brandStory.aboutTitle}
            </h2>
            <p>{ui.secondary.brandStory.aboutDescription}</p>
          </div>
          <a
            href={brandStory.href}
            lang={brandStory.locale !== locale ? brandStory.locale : undefined}
            hreflang={brandStory.locale}
          >
            {brandStory.locale === locale
              ? ui.secondary.brandStory.aboutLink
              : ui.secondary.brandStory.aboutLinkOtherLocale}
          </a>
        </section>
      )
    }
  </article>
</BaseLayout>
