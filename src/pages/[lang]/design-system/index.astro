---
import SystemGraphic from '../../../components/global/SystemGraphic.astro';
import {
  getAlternateLocale,
  locales,
  type Locale,
} from '../../../i18n/locales';
import { getUi } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
const ui = getUi(locale);
const alternateLocale = getAlternateLocale(locale);
const alternatePath = `/${alternateLocale}/design-system/`;
---

<BaseLayout
  locale={locale}
  title={`${ui.designSystem.title} — ${ui.siteName}`}
  description={ui.designSystem.intro}
  alternatePath={alternatePath}
  noindex
  pagefindExclude
>
  <article class="design-system page-shell" data-design-system>
    <header class="hero">
      <div class="hero__copy">
        <p class="eyebrow">{ui.designSystem.sampleLabel}</p>
        <h1>{ui.designSystem.title}</h1>
        <p class="hero__intro">{ui.designSystem.intro}</p>
      </div>
      <figure class="hero__graphic">
        <SystemGraphic />
        <figcaption>
          <strong>{ui.designSystem.graphicTitle}</strong>
          <span>{ui.designSystem.graphicBody}</span>
        </figcaption>
      </figure>
    </header>

    <section class="system-section" aria-labelledby="typography-title">
      <header class="section-heading">
        <p class="section-index" aria-hidden="true">01</p>
        <h2 id="typography-title">{ui.designSystem.typographyTitle}</h2>
      </header>

      <div class="reading-column prose">
        <h3 class="display-sample">{ui.designSystem.headingDisplay}</h3>
        <h4>{ui.designSystem.headingSection}</h4>
        <p>{ui.designSystem.prose}</p>
        <p><a href="#focus-sample">{ui.designSystem.linkLabel}</a></p>
        <ul>
          {ui.designSystem.listItems.map((item) => <li>{item}</li>)}
        </ul>
        <blockquote>
          <p>{ui.designSystem.quote}</p>
          <footer>— {ui.designSystem.quoteSource}</footer>
        </blockquote>
      </div>
    </section>

    <section class="system-section" aria-labelledby="components-title">
      <header class="section-heading">
        <p class="section-index" aria-hidden="true">02</p>
        <h2 id="components-title">{ui.designSystem.componentsTitle}</h2>
      </header>

      <div class="component-stack">
        <aside class="callout">
          <h3>{ui.designSystem.calloutTitle}</h3>
          <p>{ui.designSystem.calloutBody}</p>
        </aside>

        <article class="editorial-row">
          <p class="editorial-row__index">{ui.designSystem.rowIndex}</p>
          <div>
            <h3>{ui.designSystem.rowTitle}</h3>
            <p>{ui.designSystem.rowSummary}</p>
          </div>
          <p class="editorial-row__meta">{ui.designSystem.rowMeta}</p>
        </article>

        <div class="table-scroll" tabindex="0">
          <table>
            <caption>{ui.designSystem.tableCaption}</caption>
            <thead>
              <tr>
                {
                  ui.designSystem.tableHeaders.map((header) => (
                    <th scope="col">{header}</th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              <tr>
                {ui.designSystem.tableRow.map((cell) => <td>{cell}</td>)}
              </tr>
            </tbody>
          </table>
        </div>

        <div class="code-sample">
          <p>{ui.designSystem.codeLabel}</p>
          <pre><code>{ui.designSystem.codeSample}</code></pre>
        </div>

        <div class="focus-sample" id="focus-sample">
          <button type="button">{ui.designSystem.focusLabel}</button>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .design-system {
    padding-block-start: clamp(3rem, 8vw, 7rem);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    min-block-size: min(42rem, calc(100vh - var(--header-height)));
    padding-block-end: var(--section-space);
  }

  .hero__copy {
    max-inline-size: 42rem;
  }

  .hero h1 {
    margin-block-start: var(--space-5);
  }

  .hero__intro {
    max-inline-size: 38rem;
    margin-block-start: var(--space-8);
    color: var(--color-lapis);
    font-family: var(--font-reading);
    font-size: var(--step-1);
    line-height: var(--reading-leading);
  }

  .hero__graphic {
    min-inline-size: 0;
  }

  .hero__graphic figcaption {
    display: grid;
    gap: var(--space-2);
    border-block-start: var(--border-thin) solid var(--color-rule);
    padding-block-start: var(--space-4);
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  .hero__graphic figcaption strong {
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--step-0);
  }

  .system-section {
    border-block-start: var(--border-thin) solid var(--color-ink);
    padding-block: var(--section-space);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(3rem, 0.18fr) minmax(0, 1fr);
    gap: var(--space-6);
    margin-block-end: clamp(3rem, 7vw, 6rem);
  }

  .section-index {
    padding-block-start: var(--space-2);
    color: var(--color-accent);
    font-family: var(--font-code);
    font-size: var(--step--1);
  }

  .display-sample {
    font-size: var(--step-4);
  }

  .component-stack {
    display: grid;
    gap: var(--space-12);
  }

  .callout {
    max-inline-size: var(--reading-max);
    border-inline-start: 0.3rem solid var(--color-lapis);
    padding-block: var(--space-5);
    padding-inline: var(--space-6);
    background: var(--color-surface);
  }

  .callout h3 {
    font-size: var(--step-1);
  }

  .callout p {
    margin-block-start: var(--space-3);
    line-height: var(--reading-leading);
  }

  .editorial-row {
    display: grid;
    grid-template-columns: minmax(2.5rem, 0.12fr) minmax(0, 1fr) auto;
    gap: var(--space-6);
    border-block: var(--border-thin) solid var(--color-rule);
    padding-block: var(--space-6);
  }

  .editorial-row__index,
  .editorial-row__meta {
    color: var(--color-muted);
    font-family: var(--font-code);
    font-size: var(--step--1);
  }

  .editorial-row h3 {
    font-size: var(--step-1);
  }

  .editorial-row div p {
    max-inline-size: 44rem;
    margin-block-start: var(--space-2);
    color: var(--color-muted);
    line-height: 1.65;
  }

  .editorial-row__meta {
    text-align: end;
  }

  .table-scroll {
    max-inline-size: 100%;
    overflow-x: auto;
  }

  table {
    inline-size: 100%;
    min-inline-size: 32rem;
    text-align: start;
  }

  caption {
    margin-block-end: var(--space-3);
    color: var(--color-muted);
    font-size: var(--step--1);
    text-align: start;
  }

  th,
  td {
    border-block-end: var(--border-thin) solid var(--color-rule);
    padding-block: var(--space-4);
    padding-inline: var(--space-3);
    text-align: start;
  }

  th {
    border-block-end-color: var(--color-ink);
    color: var(--color-lapis);
    font-size: var(--step--1);
  }

  .code-sample {
    display: grid;
    gap: var(--space-3);
  }

  .code-sample > p {
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  pre {
    max-inline-size: 100%;
    overflow-x: auto;
    border-inline-start: var(--border-accent) solid var(--color-accent);
    padding: var(--space-5);
    background: var(--color-code-bg);
    font-family: var(--font-code);
    font-size: var(--step--1);
  }

  .focus-sample {
    padding-block: var(--space-4);
  }

  .focus-sample button {
    border: var(--border-thin) solid var(--color-ink);
    border-radius: var(--radius-sm);
    padding-block: var(--space-3);
    padding-inline: var(--space-5);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .focus-sample button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (max-width: 48rem) {
    .hero {
      grid-template-columns: 1fr;
      min-block-size: auto;
    }

    .hero__graphic {
      max-inline-size: 34rem;
    }

    .editorial-row {
      grid-template-columns: minmax(2.5rem, 0.12fr) minmax(0, 1fr);
    }

    .editorial-row__meta {
      grid-column: 2;
      text-align: start;
    }
  }

  @media (max-width: 25rem) {
    .section-heading {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .editorial-row {
      gap: var(--space-4);
    }

    .callout {
      padding-inline: var(--space-4);
    }
  }
</style>
