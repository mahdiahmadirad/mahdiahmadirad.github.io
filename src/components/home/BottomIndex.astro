---
import type { Locale } from '../../i18n/locales';
import { getUi } from '../../i18n/ui';
import type { HomeTopic } from '../../lib/home';

interface Props {
  locale: Locale;
  topics: HomeTopic[];
}

const { locale, topics } = Astro.props;
const ui = getUi(locale);
---

<section class="bottom-index" aria-labelledby="home-topics-title">
  <div class="bottom-index__inner page-shell">
    <section>
      <h2 id="home-topics-title">{ui.home.topics}</h2>
      <ul>
        {
          topics.map((topic) => (
            <li>
              <a href={topic.href}>{topic.name}</a>
              <p>{topic.description}</p>
            </li>
          ))
        }
      </ul>
      <a class="bottom-index__more" href={`/${locale}/topics/`}>
        {ui.home.viewTopics}
      </a>
    </section>
  </div>
</section>

<style>
  .bottom-index {
    border-block: var(--border-thin) solid var(--color-rule);
  }

  .bottom-index__inner > section {
    max-inline-size: 48rem;
    padding-block: var(--space-10);
  }

  .bottom-index h2 {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    text-transform: none;
  }

  .bottom-index ul {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    margin: var(--space-5) 0 0;
    list-style: none;
  }

  .bottom-index li a {
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--step-0);
    font-weight: 600;
  }

  .bottom-index li p {
    margin-block-start: var(--space-2);
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .bottom-index__more {
    display: inline-flex;
    min-block-size: var(--tap-min);
    align-items: center;
    margin-block-start: var(--space-5);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
</style>
