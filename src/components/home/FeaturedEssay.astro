---
import type { Locale } from '../../i18n/locales';
import type { HomeArticle } from '../../lib/home';
import ArticleArtwork from '../article/ArticleArtwork.astro';
import ArticleMeta from './ArticleMeta.astro';
import DecisionFlowGraphic from './DecisionFlowGraphic.astro';
import EditionLinks from './EditionLinks.astro';

interface Props {
  locale: Locale;
  article: HomeArticle;
}

const { locale, article } = Astro.props;
const featuredLabel = locale === 'fa' ? 'نوشته‌ی برگزیده' : 'Featured writing';
const readLabel = locale === 'fa' ? 'مطالعه‌ی نوشته' : 'Read the essay';
---

<section class="featured page-shell" aria-labelledby="featured-title">
  <div class="featured__copy">
    <p class="eyebrow">{featuredLabel}</p>
    <h2 id="featured-title">
      <a href={article.href}>{article.title}</a>
    </h2>
    <p class="featured__deck">{article.description}</p>
    <ArticleMeta
      topic={article.topic}
      readingTime={article.readingTime}
      date={article.date}
    />
    <div class="featured__actions">
      <a class="featured__read" href={article.href}>{readLabel}</a>
      <EditionLinks locale={locale} editions={article.editions} />
    </div>
  </div>
  {
    article.cover ? (
      <ArticleArtwork
        artwork={article.cover}
        className="featured__graphic featured__artwork"
      />
    ) : (
      <figure class="featured__graphic featured__fallback">
        <DecisionFlowGraphic />
      </figure>
    )
  }
</section>

<style>
  .featured {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-6);
    border-block: var(--border-thin) solid var(--color-rule);
    padding-block: var(--section-space);
  }

  .featured__copy {
    grid-column: 1 / span 5;
    align-self: center;
  }

  .featured h2 {
    margin-block-start: var(--space-5);
    font-size: var(--step-4);
  }

  .featured h2 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .featured h2 a:hover {
    color: var(--color-accent);
  }

  .featured__deck {
    max-inline-size: 34rem;
    margin-block-start: var(--space-6);
    font-family: var(--font-reading);
    line-height: var(--reading-leading);
  }

  .featured :global(.article-meta) {
    margin-block-start: var(--space-6);
  }

  .featured__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    margin-block-start: var(--space-8);
  }

  .featured__read {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    font-weight: 700;
  }

  :global(.featured__graphic) {
    position: relative;
    grid-column: 7 / -1;
    overflow: hidden;
  }

  .featured__fallback {
    background: var(--color-ink);
  }

  :global(.featured__artwork) {
    inline-size: min(100%, 31rem);
    justify-self: end;
  }

  @media (max-width: 48rem) {
    .featured {
      grid-template-columns: 1fr;
    }

    .featured__copy,
    :global(.featured__graphic) {
      grid-column: 1;
    }

    :global(.featured__graphic) {
      margin-block-start: var(--space-6);
    }

    :global(.featured__artwork) {
      inline-size: min(100%, 28rem);
      justify-self: start;
    }
  }
</style>
