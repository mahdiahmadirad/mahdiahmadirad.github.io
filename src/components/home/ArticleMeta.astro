---
interface Props {
  topic: string;
  readingTime: string;
  date: string;
}

const { topic, readingTime, date } = Astro.props;
---

<p class="article-meta">
  <span>{topic}</span>
  <span aria-hidden="true">·</span>
  <span>{readingTime}</span>
  <span aria-hidden="true">·</span>
  <time>{date}</time>
</p>

<style>
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
</style>
