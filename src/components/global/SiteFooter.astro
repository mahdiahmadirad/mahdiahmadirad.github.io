---
import type { Locale } from '../../i18n/locales';
import { rssPath, searchPath } from '../../i18n/routing';
import { getUi } from '../../i18n/ui';

interface Props {
  locale: Locale;
  alternatePath: string;
}

const { locale, alternatePath } = Astro.props;
const ui = getUi(locale);
const year = new Date().getUTCFullYear();
const socialLinks = {
  github: 'https://github.com/mahdiahmadirad',
  linkedin: 'https://www.linkedin.com/in/mehdiahmadirad',
} as const;
---

<footer class="site-footer">
  <div class="site-footer__inner page-shell">
    <div>
      <p>© {year} {ui.siteName}</p>
      <p>{ui.footer.sampleNotice}</p>
    </div>
    <nav aria-label={ui.accessibility.secondaryNavigation}>
      <a href={searchPath(locale)}>{ui.footer.search}</a>
      <a href={rssPath(locale)}>{ui.footer.rss}</a>
      <a
        href={socialLinks.github}
        target="_blank"
        rel="me noopener noreferrer"
      >
        {ui.footer.github}
      </a>
      <a
        href={socialLinks.linkedin}
        target="_blank"
        rel="me noopener noreferrer"
      >
        {ui.footer.linkedin}
      </a>
      <a href={alternatePath} lang={locale === 'fa' ? 'en' : 'fa'}>
        {ui.language[locale === 'fa' ? 'en' : 'fa']}
      </a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: var(--border-thin) solid var(--color-rule);
    margin-block-start: var(--section-space);
  }

  :global(.footer-flush) .site-footer {
    margin-block-start: 0;
  }

  .site-footer__inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-6);
    color: var(--color-muted);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }

  .site-footer__inner > div {
    display: grid;
    gap: var(--space-2);
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-end;
    gap: var(--space-3) var(--space-5);
  }

  .site-footer a {
    color: var(--color-ink);
  }

  @media (max-width: 40rem) {
    .site-footer__inner {
      flex-direction: column;
      gap: var(--space-2);
    }

    .site-footer nav {
      justify-content: flex-start;
    }
  }
</style>
