---
interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  notice?: string;
}

const { title, intro } = Astro.props;
---

<header class="secondary-intro page-shell">
  <div class="secondary-intro__copy">
    <h1>{title}</h1>
    <p class="secondary-intro__deck">{intro}</p>
  </div>
</header>
