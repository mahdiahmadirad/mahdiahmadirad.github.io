---
import BaseLayout from './BaseLayout.astro';
import BidiText from '../components/content/BidiText.astro';
import type { Locale } from '../i18n/locales';
import { getAlternateLocale } from '../i18n/locales';
import { localeHomePath } from '../i18n/routing';
import { getUi } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const alternatePath = localeHomePath(getAlternateLocale(locale));
---

<BaseLayout
  locale={locale}
  title={ui.foundation.title}
  alternatePath={alternatePath}
  noindex
>
  <div class="page-shell foundation">
    <div class="reading-column prose">
      <h1>{ui.siteName}</h1>
      <p>{ui.foundation.sampleNotice}</p>
      <p><BidiText value={ui.foundation.bidiExample} /></p>
    </div>
  </div>
</BaseLayout>

<style>
  .foundation {
    padding-block: var(--section-space);
  }
</style>
