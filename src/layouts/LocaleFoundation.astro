---
import BidiText from '../components/content/BidiText.astro';
import type { Locale } from '../i18n/locales';
import { getDirection } from '../i18n/locales';
import { getUi } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
---

<!doctype html>
<html lang={locale} dir={getDirection(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>{ui.foundation.title}</title>
  </head>
  <body>
    <main>
      <h1>{ui.siteName}</h1>
      <p>{ui.foundation.sampleNotice}</p>
      <p><BidiText value={ui.foundation.bidiExample} /></p>
    </main>
  </body>
</html>
