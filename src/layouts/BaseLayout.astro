---
import SiteFooter from '../components/global/SiteFooter.astro';
import SiteHeader from '../components/global/SiteHeader.astro';
import SiteMetadata from '../components/global/SiteMetadata.astro';
import SkipLink from '../components/global/SkipLink.astro';
import type { Locale } from '../i18n/locales';
import { getDirection } from '../i18n/locales';
import { getUi } from '../i18n/ui';
import type { ArticleMetadata } from '../lib/metadata';
import '../styles/main.css';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  alternatePath: string;
  noindex?: boolean;
  currentPath?: string;
  footerFlush?: boolean;
  canonicalPath?: string;
  alternates?: Partial<Record<Locale, string>>;
  pageType?: string;
  pageTopic?: string;
  articleMetadata?: ArticleMetadata;
  pagefindExclude?: boolean;
}

const {
  locale,
  title,
  description,
  alternatePath,
  currentPath,
  footerFlush = false,
  canonicalPath,
  alternates = {},
  pageType,
  pageTopic,
  articleMetadata,
  pagefindExclude = false,
} = Astro.props;
const ui = getUi(locale);
const criticalFonts: Record<Locale, readonly string[]> = {
  fa: [
    '/fonts/vazirmatn/vazirmatn-variable.woff2',
    '/fonts/estedad/estedad-variable.woff2',
  ],
  en: [
    '/fonts/source-serif-4/mar-editorial-lcp.woff2',
    '/fonts/inter/inter-latin.woff2',
  ],
};
---

<!doctype html>
<html lang={locale} dir={getDirection(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {
      criticalFonts[locale].map((href) => (
        <link
          rel="preload"
          href={href}
          as="font"
          type="font/woff2"
          crossorigin="anonymous"
        />
      ))
    }
    <SiteMetadata
      locale={locale}
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      alternates={alternates}
      pageType={pageType}
      pageTopic={pageTopic}
      article={articleMetadata}
    />
    <title>{title}</title>
  </head>
  <body class:list={{ 'footer-flush': footerFlush }}>
    <SkipLink label={ui.accessibility.skipToContent} />
    <SiteHeader
      locale={locale}
      alternatePath={alternatePath}
      currentPath={currentPath}
    />
    <main
      id="main-content"
      tabindex="-1"
      data-pagefind-body={!pagefindExclude ? '' : undefined}
      data-pagefind-ignore={pagefindExclude ? '' : undefined}
    >
      <slot />
    </main>
    <SiteFooter locale={locale} alternatePath={alternatePath} />
  </body>
</html>
